          <mxGeometry height="40" width="412" x="1369" y="228" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;fontStyle=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4;" value="SECURITY GROUPS (patrón de cadena · menor privilegio)" vertex="1">
          <mxGeometry height="270" width="440" x="1355" y="322" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-48" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#7d4000;fillColor=#FFF3E0;strokeColor=#FFB74D;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-api&lt;/b&gt; (events-api)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;Entrada: TCP 8080 ← NLB (VPC Link)&lt;br&gt;Salida:  TCP 443  → SG-endpoints (DynamoDB/Secrets/SQS)&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="412" x="1369" y="358" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-49" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B71C1C;fillColor=#FDE7EA;strokeColor=#EF9A9A;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-worker&lt;/b&gt; (events-delivery · events-simulator)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;Entrada: — (nadie inicia hacia el worker)&lt;br&gt;Salida:  TCP 443 → SG-endpoints (SQS/DynamoDB/Secrets)&lt;br&gt;Salida:  TCP 443 → 0.0.0.0/0 (NAT · webhooks del cliente)&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="412" x="1369" y="418" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-50" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#4527A0;fillColor=#EDE7F6;strokeColor=#B39DDB;spacingLeft=8;spacingTop=6;arcSize=6;rounded=1;" value="&lt;b&gt;SG-endpoints&lt;/b&gt; (Interface Endpoints: SQS, Secrets, ECR, CloudWatch)&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:8px&quot;&gt;Entrada: TCP 443 ← SG-api, SG-worker&lt;/span&gt;" vertex="1">
          <mxGeometry height="48" width="412" x="1369" y="490" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-51" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#1B5E20;fontStyle=2;spacingLeft=8;" value="Los SG se referencian por SG-origen (no IPs). S3 y DynamoDB (Gateway Endpoints) no usan SG: se controlan por route table. El NAT no usa SG." vertex="1">
          <mxGeometry height="42" width="412" x="1369" y="544" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#ED7100;fontColor=#E65100;fontStyle=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4;" value="UBICACIÓN DE RED · servicios de cómputo (3 en Fargate)" vertex="1">
          <mxGeometry height="180" width="440" x="1355" y="606" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-53" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=5;arcSize=6;rounded=1;" value="&lt;b&gt;EN LA VPC (subred privada, sin IP pública)&lt;/b&gt;&lt;br&gt;· events-api — recibe solo vía API Gateway → VPC Link (NLB)&lt;br&gt;· events-delivery — consume SQS, entrega webhooks por NAT&lt;br&gt;· events-simulator — produce eventos (andamiaje)" vertex="1">
          <mxGeometry height="66" width="412" x="1369" y="638" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-54" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#6d4c00;fontStyle=2;fillColor=#FFFDE7;strokeColor=#FFE082;spacingLeft=6;spacingTop=4;rounded=1;arcSize=8;" value="Regla anti-SSRF: el único tráfico a internet público (0.0.0.0/0 → NAT) es la entrega a webhooks. Todo lo AWS-interno (SQS, DynamoDB, Secrets, ECR, CloudWatch) va por VPC Endpoints: no toca NAT ni internet. Fargate sin IP pública + IMDSv2/hop-limit + validación de URL completan la mitigación." vertex="1">
          <mxGeometry height="66" width="412" x="1369" y="710" as="geometry" />
        </mxCell>
        <mxCell id="VJHiICVZU0686kHP1PtP-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0BEC5;fontColor=#455A64;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=6;fontStyle=1;" value="LEYENDA&#xa;&lt;span style=&quot;font-weight:normal&quot;&gt;· &lt;b&gt;2 AZ para HA&lt;/b&gt;: cómputo replicado; SQS y DynamoDB son regionales multi-AZ nativos (no se &quot;duplican&quot;). · &lt;b&gt;2 NAT (uno por AZ)&lt;/b&gt; para no perder egreso si cae una AZ; el NAT procesa el tráfico de webhooks → su costo (hora + GB) es evaluable a 1 NAT si se acepta el riesgo de una AZ. · &lt;b&gt;Gateway Endpoints&lt;/b&gt; (S3, DynamoDB) = gratis, por route table; &lt;b&gt;Interface Endpoints&lt;/b&gt; (SQS, Secrets, ECR, CloudWatch) = por SG. · API Gateway y las colas son gestionados: no viven dentro de la VPC.&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="1128" x="200" y="830" as="geometry" />
        </mxCell>
