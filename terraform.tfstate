            "id": "2082804558",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"SqsWork\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sqs:SendMessage\",\n        \"sqs:ReceiveMessage\",\n        \"sqs:GetQueueAttributes\",\n        \"sqs:DeleteMessage\",\n        \"sqs:ChangeMessageVisibility\"\n      ],\n      \"Resource\": [\n        \"arn:aws:sqs:us-east-1:470044069342:cobre-notif-dev-raw-events\",\n        \"arn:aws:sqs:us-east-1:470044069342:cobre-notif-dev-deliveries\"\n      ]\n    },\n    {\n      \"Sid\": \"Dynamo\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:UpdateItem\",\n        \"dynamodb:Query\",\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\"\n      ],\n      \"Resource\": [\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-subscriptions/index/*\",\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-subscriptions\",\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events/index/*\",\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events\"\n      ]\n    },\n    {\n      \"Sid\": \"SecretsRead\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"secretsmanager:GetSecretValue\",\n      \"Resource\": \"arn:aws:secretsmanager:us-east-1:*:secret:cobre/webhook-hmac/*\"\n    },\n    {\n      \"Sid\": \"CloudWatchMetrics\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"cloudwatch:PutMetricData\",\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"cloudwatch:namespace\": [\n            \"notification-events-delivery\",\n            \"notification-events-api\",\n            \"notification-events-simulator\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"DynamoKmsAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:GenerateDataKey\",\n        \"kms:Decrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:us-east-1:470044069342:key/bbfcad45-ca45-4783-8988-00fb28462c10\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"SqsWork\",\"Effect\":\"Allow\",\"Action\":[\"sqs:SendMessage\",\"sqs:ReceiveMessage\",\"sqs:GetQueueAttributes\",\"sqs:DeleteMessage\",\"sqs:ChangeMessageVisibility\"],\"Resource\":[\"arn:aws:sqs:us-east-1:470044069342:cobre-notif-dev-raw-events\",\"arn:aws:sqs:us-east-1:470044069342:cobre-notif-dev-deliveries\"]},{\"Sid\":\"Dynamo\",\"Effect\":\"Allow\",\"Action\":[\"dynamodb:UpdateItem\",\"dynamodb:Query\",\"dynamodb:PutItem\",\"dynamodb:GetItem\"],\"Resource\":[\"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-subscriptions/index/*\",\"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-subscriptions\",\"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events/index/*\",\"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events\"]},{\"Sid\":\"SecretsRead\",\"Effect\":\"Allow\",\"Action\":\"secretsmanager:GetSecretValue\",\"Resource\":\"arn:aws:secretsmanager:us-east-1:*:secret:cobre/webhook-hmac/*\"},{\"Sid\":\"CloudWatchMetrics\",\"Effect\":\"Allow\",\"Action\":\"cloudwatch:PutMetricData\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"cloudwatch:namespace\":[\"notification-events-delivery\",\"notification-events-api\",\"notification-events-simulator\"]}}},{\"Sid\":\"DynamoKmsAccess\",\"Effect\":\"Allow\",\"Action\":[\"kms:GenerateDataKey\",\"kms:Decrypt\"],\"Resource\":\"arn:aws:kms:us-east-1:470044069342:key/bbfcad45-ca45-4783-8988-00fb28462c10\"}]}",
