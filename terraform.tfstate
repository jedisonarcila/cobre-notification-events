            "id": "585208568",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"DynamoApi\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:UpdateItem\",\n        \"dynamodb:Query\",\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": [\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-subscriptions\",\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events/index/*\",\n        \"arn:aws:dynamodb:us-east-1:470044069342:table/cobre-notif-dev-notification-events\"\n      ]\n    },\n    {\n      \"Sid\": \"SqsReplay\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"sqs:SendMessage\",\n      \"Resource\": \"arn:aws:sqs:us-east-1:470044069342:cobre-notif-dev-deliveries\"\n    },\n    {\n      \"Sid\": \"SecretsWrite\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"secretsmanager:PutSecretValue\",\n        \"secretsmanager:DescribeSecret\",\n        \"secretsmanager:CreateSecret\"\n      ],\n      \"Resource\": \"arn:aws:secretsmanager:us-east-1:*:secret:cobre/webhook-hmac/*\"\n    },\n    {\n      \"Sid\": \"DynamoKmsAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:GenerateDataKey\",\n        \"kms:Decrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:us-east-1:470044069342:key/bbfcad45-ca45-4783-8988-00fb28462c10\"\n    }\n  ]\n}",
